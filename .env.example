# Stripe — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Printify — https://printify.com/app/account/api
PRINTIFY_API_TOKEN=...
PRINTIFY_SHOP_ID=...
# Optional: once the app logs "Created Printify cost-lookup product...",
# paste that product ID here so a new one isn't created on every cold start.
PRINTIFY_COST_LOOKUP_PRODUCT_ID=

# Pricing — retail = actual Printify cost + shipping + this flat margin
PRICE_FLAT_MARGIN_CENTS=690

# Printify webhook (auto-refund on cancel/reject). Any long random string, e.g. `openssl rand -hex 32`.
# Used both as Printify's webhook signing secret and as ?token= in the webhook URL.
PRINTIFY_WEBHOOK_SECRET=

# Shown in the "Report a design" mailto link on the site (client-side, not secret).
VITE_REPORT_EMAIL=
